<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>New Globe and Neutral Consolidation: performance dashboard (review version)</title>
<style>__CSS__</style></head>
<body>
<div id="app">
  <header class="top">
    <div>
      <h1>New Globe and Neutral Consolidation: performance dashboard</h1>
      <p class="sub">Data as of <span id="asof">—</span> (latest shipment date) · <span id="nrows">—</span> shipments from 8 ERP reports</p>
    </div>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap"><span class="ribbon">Review version: static sample, no login, no refresh</span><span class="ribbon" title="Added in a later build step">Ask AI: coming in a later step</span></div>
  </header>
  <nav class="tabs" id="tabs" aria-label="Pages">
    <button type="button" data-p="overview" class="on" aria-selected="true">Overview</button>
    <button type="button" data-p="compare" aria-selected="false">Compare periods</button>
    <button type="button" data-p="customers" aria-selected="false">Customers</button>
    <button type="button" data-p="lanes" aria-selected="false">Lanes and carriers</button>
    <button type="button" data-p="ops" aria-selected="false">Operations worklist</button>
    <button type="button" data-p="ship" aria-selected="false">Shipments</button>
    <button type="button" data-p="changes" aria-selected="false">Changes since last report</button>
    <button type="button" data-p="status" aria-selected="false">Data status</button>
    <button type="button" disabled title="Needs the profit analysis report">Profit (waiting for report)</button>
  </nav>
  <section class="card" id="filters" aria-label="Filters">
    <div class="frow" id="yearRow"><span class="lbl2">Year</span><div id="ybSeg" title="Calendar year runs January to December. Accounting year follows the start month set under Definitions."><button type="button" class="btn" data-v="cal">Calendar year</button><button type="button" class="btn" data-v="fy">Accounting year</button></div><label class="f"><span>Show</span><select id="yearSel" aria-label="Year"></select></label></div>
    <div class="frow">
      <span class="lbl2">Reports</span>
      <div id="qMode" title="Click to include; click again to remove. Leave none selected to include everything."><button type="button" class="btn" data-v="air">Air</button><button type="button" class="btn" data-v="sea">Sea</button></div>
      <div id="qDir" title="Click to include; click again to remove. Leave none selected to include everything."><button type="button" class="btn" data-v="exp">Exports</button><button type="button" class="btn" data-v="imp">Imports</button></div>
      <span class="lbl2">Measure</span>
      <div id="mSeg"><button type="button" class="btn" data-v="count">Shipments</button><button type="button" class="btn" data-v="volume">Volume (t or TEU)</button></div>
      <label class="f"><input type="checkbox" id="cmp" checked> Show change vs comparison period</label>
      <button type="button" class="btn" id="defBtn" aria-expanded="false">Definitions ⚙</button>
    </div>
    <div class="frow">
      <label class="f"><span>From</span><input type="date" id="dFrom" aria-label="From date"></label>
      <label class="f"><span>To</span><input type="date" id="dTo" aria-label="To date"></label>
      <div id="presets"><button type="button" class="btn" data-v="30">Last 30 days</button><button type="button" class="btn" data-v="month">This month</button><button type="button" class="btn" data-v="last">Last month</button><button type="button" class="btn" data-v="ytd">Year to date</button><button type="button" class="btn" data-v="all">All dates</button></div>
      <span class="f" id="relBox">Last <input type="number" id="relN" min="1" max="3650" value="30" aria-label="How many"> <select id="relU" aria-label="Unit"><option value="days">days</option><option value="weeks">weeks</option><option value="months">months</option><option value="years">years</option><option value="cweeks">complete weeks</option><option value="cmonths">complete months</option></select> <button type="button" class="btn" id="relGo">Apply</button></span>
    </div>
    <div class="frow" id="fbtns"></div>
    <div class="frow" id="chips"></div>
    <div id="defs" class="defs" hidden></div>
    <div id="status"></div>
  </section>
  <main id="page"></main>
  <footer>Review version. Click any bar, row, legend item or cell to filter everything; click again to remove. Air and sea are never added together. Every definition (top N, age limits, bands, comparison period) can be changed under Definitions. Profit is not shown yet because the registers carry no profit.</footer>
</div>
<div id="menu" hidden role="dialog" aria-label="Filter values">
  <div class="mhead"><b id="mh"></b><button id="mClose" class="x" type="button" aria-label="Close">×</button></div>
  <input id="mq" class="q" placeholder="Search values…" aria-label="Search values" autocomplete="off">
  <div class="ma"><button id="mAll" class="btn" type="button">Select all</button><button id="mClear" class="btn" type="button">Clear</button></div>
  <div id="ml" class="ml"></div><p id="mf" class="mfoot"></p>
</div>
<script type="text/plain" id="data">__DATA__</script>
<script>__FFLATE__</script>
<script>__D3__</script>
<script>__APP__</script>
</body></html>
