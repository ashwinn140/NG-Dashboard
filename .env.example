# Variables for Railway (service > Variables). Real values never go into GitHub.
# Only the first four are required. Everything else is optional and can be added later.
#
# REQUIRED
# DATABASE_URL: choose "Add reference" and pick the PostgreSQL service's DATABASE_URL.
DATABASE_URL=
# SECRET_KEY: a long random text (40+ characters).
SECRET_KEY=
# INGEST_SECRET: the password the Gmail script uses (another long random text).
INGEST_SECRET=
# ADMIN_EMAIL: the first administrator is created from this address on first start.
ADMIN_EMAIL=
#
# OPTIONAL
# ADMIN_PASSWORD: a first password for that administrator (10+ characters, letters and a number). Delete it once you can sign in.
ADMIN_PASSWORD=
# ADMIN_NAME: the first administrator's display name (default: Administrator).
ADMIN_NAME=
# PRODUCT_NAME: the name shown on the pages and in emails.
PRODUCT_NAME=Performance Dashboard
# BASE_URL: normally NOT needed; the app uses the address people open. Set it only for a custom domain.
BASE_URL=
# SMTP_*: for emailed sign-in links. SMTP_PASSWORD is a Google App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# ALERT_EMAIL: who is told when a report fails or is held (can also be set in the admin portal).
ALERT_EMAIL=
