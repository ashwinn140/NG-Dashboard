# Copy these into Railway > your service > Variables. Never put real values in GitHub.
PRODUCT_NAME=Performance Dashboard        # the product name shown on the pages and in emails (optional; this is the default)
DATABASE_URL=            # Railway fills this in when you add PostgreSQL (use the variable reference)
SECRET_KEY=              # a long random text, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
BASE_URL=https://your-app.up.railway.app     # the address people open; used in sign-in links
INGEST_SECRET=           # the password the Gmail script uses; another long random text
ADMIN_EMAIL=you@company.com                  # the first administrator is created from this on the first start
ADMIN_PASSWORD=          # optional first password (10+ characters, letters and a number); you can sign in by email link instead
UPLOAD_DIR=/data/uploads                     # a Railway Volume mounted at /data keeps the original files
ALERT_EMAIL=             # optional: who is emailed when a report fails or is held (also settable in the admin portal)
# Email for sign-in links (Gmail with an App Password to start)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ashwin0project@gmail.com
SMTP_PASSWORD=           # the 16-character Google App Password, not the account password
MAIL_FROM=ashwin0project@gmail.com
