      h('td', null, h('span', {class: 'pill' + (st[i] === STAGE_PEND ? ' warn' : '')}, st[i] === STAGE_PEND ? 'Waiting for ops lock' : 'Financials open')), h('td', null, KEY.status(i)), h('td', {class: 'n'}, fInt(age(i))))));
