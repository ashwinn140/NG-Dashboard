    h('div', {class: 'legend'}, h('span', {class: 'lg static'}, h('i', {class: 'sw', style: 'background:' + REPCOL[0]}), 'Financials open'), h('span', {class: 'lg static'}, h('i', {class: 'sw', style: 'background:' + REPCOL[1]}), 'Waiting for ops lock')));
